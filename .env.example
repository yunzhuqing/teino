# Neon 连接串（Vercel Neon 集成会自动注入 DATABASE_URL）
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# 管理后台登录密码
ADMIN_PASSWORD="change-me"

# 用于会话签名与供应商密钥加密，至少 32 位随机字符串（openssl rand -base64 32）
# 注意：修改后已保存的供应商密钥将无法解密
GATEWAY_SECRET="replace-with-a-long-random-string"

# 可选：单次请求最多尝试的上游数量（默认 3）
# GATEWAY_MAX_ATTEMPTS=3
# 可选：等待上游响应头的超时（毫秒，默认 60000）
# GATEWAY_UPSTREAM_TIMEOUT_MS=60000
# 可选：协议转换为 Anthropic Messages 且调用方未传 max_tokens 时的兜底值（默认 4096，可在模型上单独覆盖）
# GATEWAY_DEFAULT_MAX_TOKENS=4096
